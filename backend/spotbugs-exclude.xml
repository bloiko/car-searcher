<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter.

  Scope: EI_EXPOSE_REP2 only, only where a Spring-managed collaborator
  (a client/service handle, not a mutable data object) is stored via
  constructor injection. There is no meaningful "defensive copy" for a
  type like OpenSearchClient — it is a stateless API handle, not a data
  holder — so the standard SpotBugs advice (clone/copy the argument)
  does not apply. This does not touch any other bug pattern or class.
-->
<FindBugsFilter>
    <Match>
        <Class name="dev.bloiko.carsearcher.car.CarIndexingService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="dev.bloiko.carsearcher.car.CarSearchService" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="dev.bloiko.carsearcher.car.CarIndexBootstrap" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <Match>
        <Class name="dev.bloiko.carsearcher.car.EmbeddingPipelineBootstrap" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <!--
      EI_EXPOSE_REP only, only for Car.photoUrls(). The compact constructor
      assigns photoUrls = List.copyOf(photoUrls), so the field is already an
      immutable list; SpotBugs cannot statically prove List.copyOf's result
      is immutable and flags the accessor anyway. No defensive copy is
      needed because there is nothing mutable to defend.
    -->
    <Match>
        <Class name="dev.bloiko.carsearcher.car.Car" />
        <Method name="photoUrls" />
        <Bug pattern="EI_EXPOSE_REP" />
    </Match>
</FindBugsFilter>
